# Git LFS tracking for large files
# =================================

# Critical binaries (needed for operation, tracked with LFS)
# These take significant time to build, so we provide them pre-built for x86_64 Linux
circom/stark_verify filter=lfs diff=lfs merge=lfs -text
circom/stark_verify.dat filter=lfs diff=lfs merge=lfs -text
circom/prover filter=lfs diff=lfs merge=lfs -text
circom/stark_verify_final.zkey filter=lfs diff=lfs merge=lfs -text

# Circuit and proof file extensions (if committed)
*.zkey filter=lfs diff=lfs merge=lfs -text
*.ptau filter=lfs diff=lfs merge=lfs -text
*.r1cs filter=lfs diff=lfs merge=lfs -text
*.ccs filter=lfs diff=lfs merge=lfs -text
*.dat filter=lfs diff=lfs merge=lfs -text

# Legacy/backup large files
BACKUP/exchange_N10.ccs filter=lfs diff=lfs merge=lfs -text
out/circom_cache/circuit.r1cs filter=lfs diff=lfs merge=lfs -text
out/circom_cache/pk.bin filter=lfs diff=lfs merge=lfs -text

# Note: witness.wtns files are in .gitignore as they're runtime-generated

# Large data files
*.dat filter=lfs diff=lfs merge=lfs -text
data/*.json filter=lfs diff=lfs merge=lfs -text

# Ensure text files are normalized
*.go text eol=lf
*.rs text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.circom text eol=lf

# Binary files
*.png binary
*.jpg binary
*.pdf binary
*.zip binary
*.tar.gz binary
